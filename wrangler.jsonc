// Put this file at the TOP of the GitHub repo (next to the streetkings_site folder, not inside it).
// It points Cloudflare at the site and the API that live inside streetkings_site/.
{
  "name": "streetkings-site",
  "main": "streetkings_site/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./streetkings_site/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // plain settings live here; DISCORD_BOT_TOKEN and DISCORD_WEBHOOK stay as Secrets in the dashboard only
  "vars": {
    "CFX_CODE": "bdx4xpl",
    "GALLERY_CHANNEL_ID": "1446504811557032167"
  },
  "keep_vars": true
}
